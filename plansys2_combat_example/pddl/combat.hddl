;; The battlefield of combat.pddl as a hierarchical domain (HDDL): the same actions, and the
;; tasks a commander orders. The controller (with hddl:=true) gives each round, besides its goal,
;; a task network with the same orders it would give as goals: each control point to an infantry
;; (take), the enemy tank that guards one destroyed first (destroy_enemy), the zones on the way
;; reconnoitred (reconnoitre), tanks holding the points they are on (hold).
(define (domain combat)
(:requirements :strips :typing :negative-preconditions :existential-preconditions
  :fluents :durative-actions :hierarchy :method-preconditions)

(:types
  zone robot - object
  drone ground - robot
  tank soft - ground
  infantry artillery - soft
)

(:predicates
  (mine ?r - robot)
  (hostile ?r - robot)
  (available ?r - robot)
  (at ?r - robot ?z - zone)
  (destroyed ?r - robot)
  (connected ?z1 ?z2 - zone)
  (explored ?z - zone)
  (spotted ?z - zone)
  (base ?z - zone)
  (control_point ?z - zone)
  (owned ?z - zone)
  (enemy_owned ?z - zone)
)

(:functions
  (distance ?z1 ?z2 - zone)
  (speed ?r - robot)
  (ammo ?r - robot)
  (battery ?d - drone)
  (value ?r - robot)      ; euros the robot costs
  (op_cost ?r - robot)    ; euros per action
  (shot_cost ?r - robot)  ; euros per shot
  (spent)                 ; euros spent, the metric
)


;; Tasks: what the controller orders each round, as a commander would ;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(:task take :parameters (?i - infantry ?z - zone))      ; infantry ?i takes ?z and stays there
(:task capture_point :parameters (?z - zone))           ; some infantry takes ?z
(:task destroy_enemy :parameters (?e - ground))         ; an enemy we know of, destroyed
(:task reconnoitre :parameters (?z - zone))             ; ?z explored
(:task hold :parameters (?t - tank ?z - zone))          ; tank ?t at ?z
;; and what those are made of
(:task reach :parameters (?r - ground ?z - zone))       ; ?r gets to ?z, road by road
(:task clear :parameters (?z - zone))                   ; no enemy we know of left in ?z
(:task destroy :parameters (?e - ground ?z - zone))     ; ?e destroyed where it is, ?z
(:task position :parameters (?d - drone ?z - zone))     ; drone ?d over ?z, with battery

(:method take_held
  :parameters (?i - infantry ?z - zone)
  :task (take ?i ?z)
  :precondition (owned ?z)
  :ordered-subtasks (reach ?i ?z))

; Clearing the zone and getting there may go at once; capturing, once both are done
(:method take_by_capture
  :parameters (?i - infantry ?z - zone)
  :task (take ?i ?z)
  :precondition (not (owned ?z))
  :subtasks (and (c (clear ?z)) (r (reach ?i ?z)) (k (capture ?i ?z)))
  :ordering (and (< c k) (< r k)))

(:method capture_with
  :parameters (?z - zone ?i - infantry)
  :task (capture_point ?z)
  :precondition (mine ?i)
  :ordered-subtasks (take ?i ?z))

(:method destroy_done
  :parameters (?e - ground)
  :task (destroy_enemy ?e)
  :precondition (destroyed ?e)
  :ordered-subtasks ())

(:method destroy_where
  :parameters (?e - ground ?z - zone)
  :task (destroy_enemy ?e)
  :precondition (and (hostile ?e) (at ?e ?z))
  :ordered-subtasks (destroy ?e ?z))

(:method reconnoitre_known
  :parameters (?z - zone)
  :task (reconnoitre ?z)
  :precondition (explored ?z)
  :ordered-subtasks ())

(:method reconnoitre_by_survey
  :parameters (?z - zone ?d - drone)
  :task (reconnoitre ?z)
  :precondition (and (mine ?d) (not (explored ?z)))
  :ordered-subtasks (and (position ?d ?z) (survey ?d ?z)))

(:method hold_there
  :parameters (?t - tank ?z - zone)
  :task (hold ?t ?z)
  :ordered-subtasks (reach ?t ?z))

(:method reach_here
  :parameters (?r - ground ?z - zone)
  :task (reach ?r ?z)
  :precondition (at ?r ?z)
  :ordered-subtasks ())

(:method reach_by_move
  :parameters (?r - ground ?z ?from ?next - zone)
  :task (reach ?r ?z)
  :precondition (and (mine ?r) (at ?r ?from) (connected ?from ?next) (not (at ?r ?z))
    (explored ?next) (not (exists (?e - ground) (and (hostile ?e) (at ?e ?next)))))
  :ordered-subtasks (and (move ?r ?from ?next) (reach ?r ?z)))

; Into a zone nobody has explored: what is there is known on arrival
(:method reach_by_advance
  :parameters (?r - ground ?z ?from ?next - zone)
  :task (reach ?r ?z)
  :precondition (and (mine ?r) (at ?r ?from) (connected ?from ?next) (not (at ?r ?z))
    (not (explored ?next)))
  :ordered-subtasks (and (advance ?r ?from ?next) (reach ?r ?z)))

(:method reach_by_tank_assault
  :parameters (?r - tank ?z ?from ?next - zone)
  :task (reach ?r ?z)
  :precondition (and (mine ?r) (at ?r ?from) (connected ?from ?next) (not (at ?r ?z))
    (explored ?next) (exists (?e - ground) (and (hostile ?e) (at ?e ?next))))
  :ordered-subtasks (and (assault_tank ?r ?from ?next) (reach ?r ?z)))

(:method reach_by_infantry_assault
  :parameters (?r - infantry ?z ?from ?next - zone)
  :task (reach ?r ?z)
  :precondition (and (mine ?r) (at ?r ?from) (connected ?from ?next) (not (at ?r ?z))
    (explored ?next) (exists (?e - ground) (and (hostile ?e) (at ?e ?next)))
    (not (exists (?t - tank) (and (hostile ?t) (at ?t ?next)))))
  :ordered-subtasks (and (assault_infantry ?r ?from ?next) (reach ?r ?z)))

(:method clear_empty
  :parameters (?z - zone)
  :task (clear ?z)
  :precondition (not (exists (?e - ground) (and (hostile ?e) (at ?e ?z))))
  :ordered-subtasks ())

(:method clear_one
  :parameters (?z - zone ?e - ground)
  :task (clear ?z)
  :precondition (and (hostile ?e) (at ?e ?z))
  :ordered-subtasks (and (destroy ?e ?z) (clear ?z)))

(:method destroy_by_tank
  :parameters (?e - ground ?z - zone ?t - tank)
  :task (destroy ?e ?z)
  :precondition (and (mine ?t) (>= (ammo ?t) 1))
  :ordered-subtasks (and (reach ?t ?z) (attack_tank ?t ?e ?z)))

(:method destroy_by_infantry
  :parameters (?e - soft ?z - zone ?i - infantry)
  :task (destroy ?e ?z)
  :precondition (and (mine ?i) (>= (ammo ?i) 1))
  :ordered-subtasks (and (reach ?i ?z) (attack_infantry ?i ?e ?z)))

; From a connected zone, while a drone spots the target: the drone starts spotting before the
; artillery fires, and goes on until the shot ends (orderings between time points, HDDL 2.1)
(:method destroy_by_artillery
  :parameters (?e - ground ?z - zone ?a - artillery ?d - drone ?from - zone)
  :task (destroy ?e ?z)
  :precondition (and (mine ?a) (mine ?d) (>= (ammo ?a) 1) (connected ?from ?z) (explored ?z))
  :subtasks (and (r (reach ?a ?from)) (p (position ?d ?z)) (s (spot ?d ?z))
    (b (bombard ?a ?e ?from ?z)))
  :ordering (and (< r b) (< p s) (< (start s) (start b)) (< (end b) (end s))))

(:method position_here
  :parameters (?d - drone ?z - zone)
  :task (position ?d ?z)
  :precondition (at ?d ?z)
  :ordered-subtasks ())

(:method position_by_flight
  :parameters (?d - drone ?z ?from - zone)
  :task (position ?d ?z)
  :precondition (and (at ?d ?from) (not (at ?d ?z)))
  :ordered-subtasks (fly ?d ?from ?z))

; Low battery: to the base, recharge, and on
(:method position_after_recharge
  :parameters (?d - drone ?z ?from ?b - zone)
  :task (position ?d ?z)
  :precondition (and (at ?d ?from) (base ?b) (not (at ?d ?b)) (not (at ?d ?z))
    (< (battery ?d) 40))
  :ordered-subtasks (and (fly ?d ?from ?b) (recharge ?d ?b) (fly ?d ?b ?z)))

(:method position_recharged_at_base
  :parameters (?d - drone ?z ?b - zone)
  :task (position ?d ?z)
  :precondition (and (at ?d ?b) (base ?b) (not (at ?d ?z)) (< (battery ?d) 40))
  :ordered-subtasks (and (recharge ?d ?b) (fly ?d ?b ?z)))

;; Actions: those of combat.pddl ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Ground move to an explored zone with no known enemy.
(:durative-action move
  :parameters (?r - ground ?from ?to - zone)
  :duration (= ?duration (/ (distance ?from ?to) (speed ?r)))
  :condition (and
    (at start (mine ?r))
    (at start (available ?r))
    (at start (at ?r ?from))
    (at start (connected ?from ?to))
    (at start (explored ?to))
    (at start (not (exists (?e - ground) (and (hostile ?e) (at ?e ?to))))))
  :effect (and
    (at start (not (available ?r)))
    (at start (not (at ?r ?from)))
    (at end (at ?r ?to))
    (at end (available ?r))
    (at end (increase (spent) (op_cost ?r)))))

; Ground move to an unexplored zone: what is there is known on arrival. It risks the robot.
(:durative-action advance
  :parameters (?r - ground ?from ?to - zone)
  :duration (= ?duration (/ (distance ?from ?to) (speed ?r)))
  :condition (and
    (at start (mine ?r))
    (at start (available ?r))
    (at start (at ?r ?from))
    (at start (connected ?from ?to))
    (at start (not (explored ?to))))
  :effect (and
    (at start (not (available ?r)))
    (at start (not (at ?r ?from)))
    (at end (at ?r ?to))
    (at end (explored ?to))
    (at end (available ?r))
    (at end (increase (spent) (+ (op_cost ?r) (* 0.2 (value ?r)))))))

; A tank enters a zone with known enemies.
(:durative-action assault_tank
  :parameters (?r - tank ?from ?to - zone)
  :duration (= ?duration (/ (distance ?from ?to) (speed ?r)))
  :condition (and
    (at start (mine ?r))
    (at start (available ?r))
    (at start (at ?r ?from))
    (at start (connected ?from ?to))
    (at start (explored ?to))
    (at start (exists (?e - ground) (and (hostile ?e) (at ?e ?to)))))
  :effect (and
    (at start (not (available ?r)))
    (at start (not (at ?r ?from)))
    (at end (at ?r ?to))
    (at end (available ?r))
    (at end (increase (spent) (+ (op_cost ?r) (* 0.1 (value ?r)))))))

; Infantry enters a zone with known enemies, but never against a tank.
(:durative-action assault_infantry
  :parameters (?r - infantry ?from ?to - zone)
  :duration (= ?duration (/ (distance ?from ?to) (speed ?r)))
  :condition (and
    (at start (mine ?r))
    (at start (available ?r))
    (at start (at ?r ?from))
    (at start (connected ?from ?to))
    (at start (explored ?to))
    (at start (exists (?e - ground) (and (hostile ?e) (at ?e ?to))))
    (at start (not (exists (?t - tank) (and (hostile ?t) (at ?t ?to))))))
  :effect (and
    (at start (not (available ?r)))
    (at start (not (at ?r ?from)))
    (at end (at ?r ?to))
    (at end (available ?r))
    (at end (increase (spent) (+ (op_cost ?r) (* 0.3 (value ?r)))))))

; Drones fly to any zone, connected or not.
(:durative-action fly
  :parameters (?d - drone ?from ?to - zone)
  :duration (= ?duration 5)
  :condition (and
    (at start (mine ?d))
    (at start (available ?d))
    (at start (at ?d ?from))
    (at start (>= (battery ?d) 10)))
  :effect (and
    (at start (not (available ?d)))
    (at start (not (at ?d ?from)))
    (at start (decrease (battery ?d) 10))
    (at end (at ?d ?to))
    (at end (available ?d))
    (at end (increase (spent) (op_cost ?d)))))

; The arbiter answers with the enemies in the zone.
(:durative-action survey
  :parameters (?d - drone ?z - zone)
  :duration (= ?duration 3)
  :condition (and
    (at start (mine ?d))
    (at start (available ?d))
    (at start (>= (battery ?d) 5))
    (over all (at ?d ?z)))
  :effect (and
    (at start (not (available ?d)))
    (at start (decrease (battery ?d) 5))
    (at end (explored ?z))
    (at end (available ?d))
    (at end (increase (spent) (op_cost ?d)))))

; The drone hovers over a zone and designates targets for the artillery, within reach of the
; enemy there (10 % of its value).
(:durative-action spot
  :parameters (?d - drone ?z - zone)
  :duration (= ?duration 12)
  :condition (and
    (at start (mine ?d))
    (at start (available ?d))
    (at start (explored ?z))
    (at start (>= (battery ?d) 10))
    (over all (at ?d ?z)))
  :effect (and
    (at start (not (available ?d)))
    (at start (decrease (battery ?d) 10))
    (at start (spotted ?z))
    (at end (not (spotted ?z)))
    (at end (available ?d))
    (at end (increase (spent) (+ (op_cost ?d) (* 0.1 (value ?d)))))))

(:durative-action recharge
  :parameters (?d - drone ?z - zone)
  :duration (= ?duration 20)
  :condition (and
    (at start (mine ?d))
    (at start (available ?d))
    (at start (base ?z))
    (over all (at ?d ?z)))
  :effect (and
    (at start (not (available ?d)))
    (at end (assign (battery ?d) 100))
    (at end (available ?d))))

; Light weapons: infantry only hurts soft targets in its zone, in close combat: it risks being
; shot back (15 % of its value).
(:durative-action attack_infantry
  :parameters (?r - infantry ?t - soft ?z - zone)
  :duration (= ?duration 3)
  :condition (and
    (at start (mine ?r))
    (at start (available ?r))
    (at start (hostile ?t))
    (at start (at ?t ?z))
    (at start (>= (ammo ?r) 1))
    (over all (at ?r ?z)))
  :effect (and
    (at start (not (available ?r)))
    (at start (decrease (ammo ?r) 1))
    (at end (not (at ?t ?z)))
    (at end (destroyed ?t))
    (at end (available ?r))
    (at end (increase (spent) (+ (+ (op_cost ?r) (shot_cost ?r)) (* 0.15 (value ?r)))))))

; The tank hurts any ground target in its zone; its armor keeps the risk low (1 % of its value).
(:durative-action attack_tank
  :parameters (?r - tank ?t - ground ?z - zone)
  :duration (= ?duration 3)
  :condition (and
    (at start (mine ?r))
    (at start (available ?r))
    (at start (hostile ?t))
    (at start (at ?t ?z))
    (at start (>= (ammo ?r) 1))
    (over all (at ?r ?z)))
  :effect (and
    (at start (not (available ?r)))
    (at start (decrease (ammo ?r) 1))
    (at end (not (at ?t ?z)))
    (at end (destroyed ?t))
    (at end (available ?r))
    (at end (increase (spent) (+ (+ (op_cost ?r) (shot_cost ?r)) (* 0.01 (value ?r)))))))

; Artillery fires at a connected zone while a drone spots it: from afar, with no risk.
(:durative-action bombard
  :parameters (?r - artillery ?t - ground ?from ?to - zone)
  :duration (= ?duration 4)
  :condition (and
    (at start (mine ?r))
    (at start (available ?r))
    (at start (hostile ?t))
    (at start (at ?t ?to))
    (at start (connected ?from ?to))
    (at start (>= (ammo ?r) 1))
    (over all (at ?r ?from))
    (over all (spotted ?to)))
  :effect (and
    (at start (not (available ?r)))
    (at start (decrease (ammo ?r) 1))
    (at end (not (at ?t ?to)))
    (at end (destroyed ?t))
    (at end (available ?r))
    (at end (increase (spent) (+ (op_cost ?r) (shot_cost ?r))))))

; Only infantry captures, and only a zone with no known enemy.
(:durative-action capture
  :parameters (?r - infantry ?z - zone)
  :duration (= ?duration 5)
  :condition (and
    (at start (mine ?r))
    (at start (available ?r))
    (at start (control_point ?z))
    (at start (not (owned ?z)))
    (over all (at ?r ?z))
    (over all (not (exists (?e - ground) (and (hostile ?e) (at ?e ?z))))))
  :effect (and
    (at start (not (available ?r)))
    (at end (owned ?z))
    (at end (not (enemy_owned ?z)))
    (at end (available ?r))
    (at end (increase (spent) (op_cost ?r)))))
)
