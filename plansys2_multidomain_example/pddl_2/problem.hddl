; The problem of the commands of the multidomain example, as a task: leia takes boli to the
; bathroom
(define (problem take_boli)
  (:domain multidomain1)
  (:objects
    leia - robot
    boli - pickable_object
    entrance kitchen bedroom dinning bathroom chargingroom - room)
  (:htn
    :parameters ()
    :ordered-subtasks (and
      (t1 (deliver boli bathroom))))
  (:init
    (connected entrance dinning) (connected dinning entrance)
    (connected dinning kitchen) (connected kitchen dinning)
    (connected dinning bedroom) (connected bedroom dinning)
    (connected bathroom bedroom) (connected bedroom bathroom)
    (connected chargingroom kitchen) (connected kitchen chargingroom)
    (charging_point_at chargingroom)
    (battery_low leia)
    (robot_at leia entrance)
    (object_at_room boli entrance))
  (:goal (and (object_at_room boli bathroom)))
)
